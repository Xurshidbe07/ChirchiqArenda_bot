# BotFather bergan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Adminlarning Telegram ID lari (vergul bilan). O'z ID ingizni @userinfobot orqali bilib oling
ADMIN_IDS=123456789,987654321

# PostgreSQL ulanish manzili
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chirchiq_arenda

# Admin Mini App (Telegram Web App).
# WEBAPP_URL bo'sh qolsa va kompyuterda `cloudflared` bo'lsa, bot o'zi vaqtinchalik HTTPS tunnel ochadi.
# Serverga joylaganda o'z domeningizni yozing, masalan: https://admin.example.uz
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# Market: Joymee'dan e'lonlarni tortish
SYNC_INTERVAL_MIN=30          # necha daqiqada yangilash (0 = o'chiq, faqat admin paneldan qo'lda)
JOYMEE_DISTRICTS=166          # Joymee tuman ID lari (vergul bilan). 166 = Chirchiq shahar,
                              # 150 = Yuqorichirchiq, 156 = O'rtachirchiq, 147 = Quyichirchiq
JOYMEE_CATEGORIES=4,5         # 4 = Kvartira, 5 = Uy/dacha, 6 = Tijorat, 7 = Yer
JOYMEE_DEAL_TYPES=2,1         # 2 = oylik ijara, 1 = kunlik ijara (faqat oylik kerak bo'lsa: 2)
USD_RATE=12500                # 1 y.e necha so'm (narx filtri uchun)

# Keep-alive: bepul hostingda server uxlab qolmasligi uchun har N daqiqada o'ziga so'rov (0 = o'chiq)
KEEPALIVE_MIN=10

# Klient e'lonlari moderatsiyasi: 0 = darhol bozorga chiqadi (admin keyin yashirishi mumkin),
# 1 = admin tasdiqlamaguncha ko'rinmaydi
MODERATION=0

# Admin panel JWT: /admin buyrug'i tokenli havola beradi, tokensiz sahifa ochilmaydi.
# ADMIN_JWT_SECRET bo'sh qolsa kalit bot tokenidan hosil qilinadi; ADMIN_TOKEN_HOURS — havola muddati
ADMIN_JWT_SECRET=
ADMIN_TOKEN_HOURS=12

# OLX'ga o'tish tugmasi (bot va market'da). Bo'sh qoldirilsa tugma chiqmaydi
OLX_URL=https://www.olx.uz/nedvizhimost/kvartiry/arenda-dolgosrochnaya/chirchik/

# /olx buyrug'i: OLX'dan so'nggi e'lonlar (proksilar orqali). OLX rad etsa bot OLX havolasini beradi.
# PROXIES: ip:port:login:parol, vergul yoki yangi qator bilan. Bo'sh bo'lsa PROXIES_FILE
# (yoki Render Secret File /etc/secrets/proxies.txt) o'qiladi, u ham bo'lmasa proksisiz.
PROXIES=
PROXIES_FILE=
OLX_CACHE_TTL=600
# OLX_QUERY=Chirchiq ijara
# OLX_CATEGORY_ID=
# OLX_CITY_ID=
