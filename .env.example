# BotFather bergan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Adminlarning Telegram ID lari (vergul bilan). O'z ID ingizni @userinfobot orqali bilib oling
ADMIN_IDS=123456789,987654321

# PostgreSQL ulanish manzili
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chirchiq_arenda

# Admin Mini App (Telegram Web App).
# WEBAPP_URL bo'sh qolsa va kompyuterda `cloudflared` bo'lsa, bot o'zi vaqtinchalik HTTPS tunnel ochadi.
# Serverga joylaganda o'z domeningizni yozing, masalan: https://admin.example.uz
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
