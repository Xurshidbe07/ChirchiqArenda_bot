# BotFather bergan token
BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Adminlarning Telegram ID lari (vergul bilan). O'z ID ingizni @userinfobot orqali bilib oling
ADMIN_IDS=123456789,987654321

# PostgreSQL ulanish manzili
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chirchiq_arenda

# Admin Mini App (Telegram Web App).
# WEBAPP_URL bo'sh qolsa va kompyuterda `cloudflared` bo'lsa, bot o'zi vaqtinchalik HTTPS tunnel ochadi.
# Serverga joylaganda o'z domeningizni yozing, masalan: https://admin.example.uz
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080

# Market: Joymee'dan e'lonlarni tortish
SYNC_INTERVAL_MIN=30          # necha daqiqada yangilash (0 = o'chiq, faqat admin paneldan qo'lda)
# Hududlar: Toshkent shahri butun + atrofidagi tumanlar
JOYMEE_REGIONS=59             # 59 = Toshkent shahri (barcha tumanlari)
JOYMEE_DISTRICTS=166,145,151,148,161,157,160,159,150,156,147,154
                              # 166 Chirchiq, 145 Bo'stonliq, 151 Qibray, 148 Zangiota, 161 Toshkent t.,
                              # 157 Nurafshon, 160/159 Yangiyo'l, 150 Yuqorichirchiq, 156 O'rtachirchiq,
                              # 147 Quyichirchiq, 154 Parkent
JOYMEE_MAX_PAGES=20           # har hudud/ijara turi bo'yicha 20 x 50 = 1000 ta eng yangi
JOYMEE_MAX_NEW=300            # bir sinxronda ko'pi bilan nechta yangi e'lon tafsiloti
JOYMEE_CATEGORIES=4,5         # 4 = Kvartira, 5 = Uy/dacha, 6 = Tijorat, 7 = Yer
JOYMEE_DEAL_TYPES=2,1         # 2 = oylik ijara, 1 = kunlik ijara (faqat oylik kerak bo'lsa: 2)

# Uybor (uybor.uz): 13 = Toshkent shahri, 12 = Toshkent viloyati. UYBOR_REGIONS= bo'sh = o'chiq
UYBOR_REGIONS=13,12
UYBOR_MAX_PAGES=20
UYBOR_CATEGORIES=7,8,9,26,27,28   # 7 Kvartira, 8 Uy, 9 Kottej, 26 Xona, 27 Dacha, 28 Xususiy uy

# Qayoda (qayoda.uz, agregator: Uybor, Realt24, Joymee, OLX va boshq.). robots.txt Crawl-delay 10s ga
# rioya qilinadi; faqat katalog sahifalari o'qiladi (13 yo'l ~8-10 daqiqa, alohida fon vazifasi).
# QAYODA_CITIES ko'rsatilmasa: toshkent + viloyatdagi 12 tuman (bot/config.py). Masalan faqat Chirchiq:
# QAYODA_CITIES=toshkent-viloyati/chirchiq
QAYODA_MAX_PAGES=10
QAYODA_INTERVAL_MIN=60

USD_RATE=12500                # 1 y.e necha so'm (narx filtri uchun)

# Keep-alive: bepul hostingda server uxlab qolmasligi uchun har N daqiqada o'ziga so'rov (0 = o'chiq)
KEEPALIVE_MIN=10

# Klient e'lonlari moderatsiyasi: 0 = darhol bozorga chiqadi (admin keyin yashirishi mumkin),
# 1 = admin tasdiqlamaguncha ko'rinmaydi
MODERATION=0

# Admin panel JWT: /admin buyrug'i tokenli havola beradi, tokensiz sahifa ochilmaydi.
# ADMIN_JWT_SECRET bo'sh qolsa kalit bot tokenidan hosil qilinadi; ADMIN_TOKEN_HOURS — havola muddati
ADMIN_JWT_SECRET=
ADMIN_TOKEN_HOURS=12


# Instagram avtopost (Instagram Graph API, Content Publishing). Token/akkaunt bo'sh = o'chiq.
# Token: Meta for Developers -> ilova -> Instagram API -> Generate token (System User tokeni muddatsiz).
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=
IG_AUTOPOST=0                 # 1 = server yangi e'lonlarni o'zi chiqaradi
IG_INTERVAL_MIN=60            # avtopost oralig'i (daqiqa)
IG_POSTS_PER_RUN=1            # har urinishda nechta post
IG_SOURCES=admin              # qaysi e'lonlar: admin = bot/market orqali berilganlar (tashqi saytlarniki emas)
IG_MAX_AGE_DAYS=3             # avtopost faqat shu kundan yangi e'lonlarni oladi
IG_BOT_USERNAME=Arenda1UzBot  # post matnidagi havola: t.me/<username>
# Instagram rasmni shu ochiq serverdan yuklaydi (lokal skript uchun ham Render manzili):
PUBLIC_BASE_URL=https://chirchiq-arenda-bot.onrender.com
